# Copy this file to .env and fill in your real key.
# NEVER commit the real .env file — it's already in .gitignore.

GEMINI_API_KEY=your-key-here
# Direct inference key returned by Bhashini pipeline configuration.
BHASHINI_INFERENCE_KEY=your-bhashini-inference-key
BHASHINI_INFERENCE_HEADER=Authorization
# Optional: use this matching pair to obtain per-task inference config dynamically.
BHASHINI_USER_ID=
# Set either this variable or BHASHINI_UDYAT_KEY (legacy alias), not both.
BHASHINI_ULCA_API_KEY=
# BHASHINI_UDYAT_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
VEDAVERSE_DB_PATH=./vedaverse_accounts.sqlite3
# Comma-separated deployed frontend origin(s); set this in the backend host.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
