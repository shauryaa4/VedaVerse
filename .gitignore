# ============================================================
# IP-SAKTI Sahayak — .gitignore
# ============================================================

# ---------- Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
dist/
build/
pip-log.txt
pip-delete-this-directory.txt

# ---------- Node / Frontend (Vite + React) ----------
frontend/node_modules/
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Data / generated at runtime ----------
chroma_data/
*.sqlite3
*.sqlite3-journal
*.db
query_log.sqlite3
mock-data/*.tmp
demo-assets/*.mp4.tmp

# NOTE: legal-corpus/ is intentionally NOT ignored -- it's a real
# hand-curated deliverable (Shau's corpus), not generated output.

# ---------- Logs ----------
*.log
logs/

# ---------- OS / editor cruft ----------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- Misc build artifacts ----------
*.tar.gz
*.zip
!VedaVerse.zip